# База данных
DATABASE_URL="postgresql://user:password@localhost:5432/loggy?schema=public" # PostgreSQL connection string

# Приложение
APP_ENV="development" # Окружение приложения (development, production)
NODE_ENV="development" # Окружение Node.js (development, production, test)
PORT=3000 # Порт, на котором будет запущен сервер
ENABLE_SWAGGER=true # Включить Swagger документацию (true/false)

# JWT Аутентификация
JWT_ACCESS_TOKEN_SECRET="your-access-token-secret-key-change-in-production" # Секретный ключ для access токенов
JWT_ACCESS_TOKEN_EXPIRATION_TIME="15m" # Время жизни access токена (например: 15m, 1h, 7d)
JWT_REFRESH_TOKEN_SECRET="your-refresh-token-secret-key-change-in-production" # Секретный ключ для refresh токенов
JWT_REFRESH_TOKEN_EXPIRATION_TIME="7d" # Время жизни refresh токена (например: 7d, 30d)

# Логи
LOG_RETENTION_DAYS=30 # Количество дней хранения логов (по умолчанию 30)
